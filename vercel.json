{
    "version": 2,
    "builds": [
      {
        "src": "server.js",
        "use": "@vercel/node"
      },
      {
        "src": "index.html",
        "use": "@vercel/static"
      },
      {
        "src": "Portfolio/**",
        "use": "@vercel/static"
      },
      {
        "src": "Psychological_Test/**",
        "use": "@vercel/static"
      },
      {
        "src": "img/**",
        "use": "@vercel/static"
      }
    ],
    "rewrites": [
      { "source": "/api/(.*)", "destination": "/server.js" },
      { "source": "/Psychological_Test/(.*)", "destination": "/Psychological_Test/$1" },
      { "source": "/Portfolio/(.*)", "destination": "/Portfolio/$1" },
      { "source": "/img/(.*)", "destination": "/img/$1" }
    ]
  }